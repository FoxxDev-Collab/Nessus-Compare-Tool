				<STIG_DATA>
					<VULN_ATTRIBUTE>Vuln_Discuss</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>Some protocols and services do not support required security features, such as encrypting passwords or traffic.</ATTRIBUTE_DATA>
