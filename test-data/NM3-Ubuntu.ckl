					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-238334r958550_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
