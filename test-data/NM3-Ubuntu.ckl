					<ATTRIBUTE_DATA>SRG-OS-000327-GPOS-00127</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-241994r922938_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
