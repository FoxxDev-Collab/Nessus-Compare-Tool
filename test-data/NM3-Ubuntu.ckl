					<ATTRIBUTE_DATA>Microsoft Windows 10 Security Technical Implementation Guide :: Version 3, Release: 4 Benchmark Date: 02 Apr 2025</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>TargetKey</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>4072</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>STIG_UUID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>cd962f1a-a9f6-4b16-8ace-fc33dda21389</ATTRIBUTE_DATA>
				</STIG_DATA>
