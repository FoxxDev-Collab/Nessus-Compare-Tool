<ReportItem port="445" svc_name="cifs" protocol="tcp" severity="4" pluginID="233872" pluginName="Microsoft Edge (Chromium) &lt; 135.0.3179.54 Multiple Vulnerabilities" pluginFamily="Windows">
<cpe>cpe:/a:microsoft:edge</cpe>
<cve>CVE-2025-3066</cve>
<cve>CVE-2025-3067</cve>
