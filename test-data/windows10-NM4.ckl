					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-223125r879627_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
