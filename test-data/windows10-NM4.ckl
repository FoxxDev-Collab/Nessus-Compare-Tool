				<STIG_DATA>
					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-221588r960879_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
