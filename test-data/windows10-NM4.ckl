					<ATTRIBUTE_DATA>SRG-APP-000206</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-221598r961083_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
