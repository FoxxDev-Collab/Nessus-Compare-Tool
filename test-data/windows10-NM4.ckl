					<ATTRIBUTE_DATA>SRG-APP-000207</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-85717r1_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
