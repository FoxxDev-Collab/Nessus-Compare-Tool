					<SID_NAME>releaseinfo</SID_NAME>
					<SID_DATA>Release: 10 Benchmark Date: 24 Oct 2024</SID_DATA>
				</SI_DATA>
				<SI_DATA>
					<SID_NAME>title</SID_NAME>
					<SID_DATA>Google Chrome Current Windows Security Technical Implementation Guide</SID_DATA>
				</SI_DATA>
				<SI_DATA>
					<SID_NAME>uuid</SID_NAME>
					<SID_DATA>707efc87-7c54-446c-ab3c-1e295e351760</SID_DATA>
				</SI_DATA>
